+"""Shared feature equivalence and real listener replay, without live devices."""
+from collections import deque
+from contextlib import redirect_stdout
+import copy
+import io
+import json
+import os
+from pathlib import Path
+import signal
+import sys
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import numpy as np
+import pytest
+import torch
+
+from cymbal_detector import listener
+from cymbal_detector.config import load_config
+from cymbal_detector.data import load_audio
+from cymbal_detector.detector import CymbalDetector
+from cymbal_detector.normality import load_configured_normality
+from cymbal_detector.shared_detector import SharedDetector
+
+
+VERSIONS = ('ride_v3', 'hihat_v2', 'snare_v2')
+
+
+def bundles():
+    root = Path(__file__).resolve().parents[1]
+    return [(load_config(root/'models'/v/'config.yaml'),
+             root/'models'/v/'best.pt', root/'models'/v/'normality/reference.npz')
+            for v in VERSIONS]
+
+
+def replay(module, config, detector, scorer, audio, *, shared=False):
+    """Run the real callback, queue, clock and decoder loop from a saved WAV."""
+    rate = detector.sample_rate
+    waveform = np.concatenate((np.zeros(round(2.1*rate), dtype=np.float32),
+                               audio.numpy(), np.zeros(rate, dtype=np.float32)))
+    block = round(config['runtime']['block_seconds']*rate)
+    state = dict(offset=0, handlers={}, callback=None)
+
+    def register(sig, handler):
+        previous = state['handlers'].get(sig)
+        state['handlers'][sig] = handler
+        return previous
+
+    class FileQueue:
+        def __init__(self, maxsize):
+            self.items = deque()
+            self.maxsize = maxsize
+
+        def put_nowait(self, item):
+            if len(self.items) >= self.maxsize:
+                raise module.queue.Full
+            self.items.append(item)
+
+        def get(self, timeout=None):
+            if not self.items:
+                start = state['offset']
+                if start == len(waveform):
+                    state['handlers'][signal.SIGINT](signal.SIGINT, None)
+                    raise module.queue.Empty
+                end = min(start+block, len(waveform))
+                state['offset'] = end
+                state['callback'](waveform[start:end, None], end-start,
+                    SimpleNamespace(currentTime=200.+end/rate, inputBufferAdcTime=200.+start/rate),
+                    SimpleNamespace(input_overflow=False))
+            return self.items.popleft()
+
+    class FileStream:
+        def __init__(self, **kwargs):
+            assert kwargs['samplerate'] == rate and kwargs['channels'] == 1
+            assert kwargs['blocksize'] == block
+            state['callback'] = kwargs['callback']
+
+        def __enter__(self): return self
+        def __exit__(self, *args): return False
+
+    output = io.StringIO()
+    with patch.dict(sys.modules, {'sounddevice': SimpleNamespace(InputStream=FileStream)}), \
+            patch.object(module.queue, 'Queue', FileQueue), \
+            patch.object(module.signal, 'signal', register), \
+            patch.object(module.time, 'monotonic', lambda: 200.+state['offset']/rate), \
+            patch.dict(os.environ, {'X5_AUDIO_TIMESTAMPS': '1'}), redirect_stdout(output):
+        if shared:
+            module.listen_shared(detector, 'offline file replay')
+        else:
+            module.listen(config, detector, scorer, 'offline file replay')
+    return [json.loads(line) for line in output.getvalue().splitlines()]
+
+
+@pytest.mark.parametrize('change, message', [
+    ('encoder', 'identical encoders'), ('timing', 'identical stream timing'),
+    ('instrument', 'Duplicate'), ('label', 'instrument/target'),
+])
+def test_incompatible_models_rejected_before_weight_load(change, message):
+    selected = bundles()
+    if change == 'encoder': selected[1][0]['encoder']['sample_rate'] = 48000
+    elif change == 'timing': selected[1][0]['runtime']['lookahead_seconds'] = .5
+    elif change == 'instrument': selected[1] = selected[0]
+    else: selected[1][0]['data']['target_label'] = 'snare_hit'
+    with patch('cymbal_detector.shared_detector.CymbalDetector') as construct, \
+            pytest.raises(ValueError, match=message):
+        SharedDetector(selected)
+    construct.assert_not_called()
+
+
+def test_shared_encoder_called_once_and_events_match_separate_models():
+    torch.set_num_threads(1)
+    selected = bundles()
+    group = SharedDetector(selected)
+    assert len({id(d.encoder) for d, _ in group.members.values()}) == 1
+    root = Path(__file__).resolve().parents[1]
+    audio = load_audio(root/'data/merged/recordings/r173.wav')
+    with patch.object(group.encoder, 'forward', wraps=group.encoder.forward) as encode:
+        combined = group.detect_waveform(audio)
+        assert encode.call_count == 1
+    for config, checkpoint, _ in selected:
+        separate = CymbalDetector(config, checkpoint).detect_waveform(audio)
+        actual = combined[config['runtime']['instrument']]
+        assert [{k:v for k,v in e.items() if k != 'inference_seconds'} for e in separate] == [
+            {k:v for k,v in e.items() if k != 'inference_seconds'} for e in actual]
+
+
+def test_streaming_state_onsets_scores_normality_and_watermarks_unchanged():
+    torch.set_num_threads(1)
+    selected = bundles()
+    group = SharedDetector(selected)
+    root = Path(__file__).resolve().parents[1]
+    audio = load_audio(root/'data/merged/recordings/r173.wav')
+    combined = replay(listener, group.config, group, None, audio, shared=True)
+    for config, checkpoint, reference in selected:
+        instrument = config['runtime']['instrument']
+        separate = replay(listener, config, CymbalDetector(config, checkpoint),
+                          load_configured_normality(config, reference), audio)
+        expected_hits = [e for e in separate if e.get('event') == 'HIT']
+        assert expected_hits == [e for e in combined if e.get('event') == 'HIT'
+                                 and e['instrument'] == instrument]
+        expected_progress = [e for e in separate if e.get('event') == 'AUDIO_PROGRESS']
+        assert expected_progress == [{k:v for k,v in e.items() if k not in ('instrument','label')}
+                                     for e in combined if e.get('event') == 'AUDIO_PROGRESS'
+                                     and e['instrument'] == instrument]
+        assert combined[-1]['captured_seconds'] == separate[-1]['captured_seconds']
