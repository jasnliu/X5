+"""Unchanged instrument heads/decoders, one identical frozen audio frontend."""
+from pathlib import Path
+import time
+
+import torch
+
+from .config import rooted
+from .decoder import decode_probabilities
+from .detector import CymbalDetector
+from .normality import load_configured_normality
+
+
+STREAM_FIELDS = ('block_seconds', 'update_seconds', 'window_seconds',
+                 'lookahead_seconds', 'queue_seconds')
+LABELS = {'ride': 'cymbal_hit', 'hihat': 'hihat_close', 'snare': 'snare_hit'}
+
+
+class SharedDetector:
+    def __init__(self, bundles):
+        """bundles: (config, explicit checkpoint, explicit normality artifact)."""
+        if not bundles:
+            raise ValueError('At least one model is required')
+        self.config = bundles[0][0]
+        self.sample_rate = int(self.config['encoder']['sample_rate'])
+        self.members = {}
+        self.encoder = None
+        # Validate before loading weights or opening a microphone. Different
+        # frontends/window schedules must never silently share feature tensors.
+        instruments = set()
+        for config, _, _ in bundles:
+            instrument = config['runtime']['instrument']
+            if instrument not in LABELS or config['data']['target_label'] != LABELS[instrument]:
+                raise ValueError('Shared model instrument/target mismatch')
+            if instrument in instruments:
+                raise ValueError('Duplicate shared instrument: ' + instrument)
+            instruments.add(instrument)
+            if (config['encoder'] != self.config['encoder'] or
+                    Path(rooted(config, config['encoder']['weights'])).resolve() !=
+                    Path(rooted(self.config, self.config['encoder']['weights'])).resolve()):
+                raise ValueError('Shared models must have identical encoders')
+            if any(config['runtime'][k] != self.config['runtime'][k] for k in STREAM_FIELDS):
+                raise ValueError('Shared models must have identical stream timing')
+        for config, checkpoint, normality_path in bundles:
+            detector = CymbalDetector(config, checkpoint, encoder=self.encoder)
+            self.encoder = detector.encoder
+            scorer = load_configured_normality(config, normality_path)
+            self.members[config['runtime']['instrument']] = (detector, scorer)
+
+    @torch.inference_mode()
+    def detect_waveform(self, waveform):
+        if waveform.ndim != 1:
+            raise ValueError('waveform must be one-dimensional mono audio')
+        started = time.perf_counter()
+        features = self.encoder(waveform.unsqueeze(0))
+        result = {}
+        for instrument, (detector, _) in self.members.items():
+            logits = detector.model(features)
+            probabilities = torch.softmax(logits, dim=-1)[0, :, 1].cpu().numpy()
+            events = decode_probabilities(probabilities, detector.decoder,
+                                          detector.frame_hop_seconds)
+            result[instrument] = [dict(detector.event_metadata, time=onset, score=score,
+                                      inference_seconds=time.perf_counter()-started)
+                                  for onset, score in events]
+        return result
