#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
void main(){
 uint r=gl_GlobalInvocationID.x,c=gl_WorkGroupID.y;if(r>=p.m)return;
 uint row=ROW()+13*r,first=uint(a[row]);double H=0.0,H1=0.0,H2=0.0;
 for(uint t=0;t<4;t++){double x=candidate(c,first+t);H+=a[row+1+t]*x;H1+=a[row+5+t]*x;H2+=a[row+9+t]*x;}
 double h2=H*H,h3=h2*H,h4=h3*H,h5=h4*H,h6=h5*H;
 double cost=0.0,g0=0.0,g1=0.0,g2=0.0,violation=-1e30;
 for(uint j=0;j<7;j++){
  double q1=a[Q()+r*7+j],q2=a[Q()+7*p.m+r*7+j],q3=a[Q()+14*p.m+r*7+j];
  double val[3]=double[3](q1/H,q2/h2-q1*H1/h3,q3/h3-3.0*q2*H1/h4-q1*H2/h4+3.0*q1*H1*H1/h5);
  double p0[3]=double[3](-q1/h2,-2.0*q2/h3+3.0*q1*H1/h4,-3.0*q3/h4+12.0*q2*H1/h5+4.0*q1*H2/h5-15.0*q1*H1*H1/h6);
  double p1[3]=double[3](0.0,-q1/h3,-3.0*q2/h4+6.0*q1*H1/h5);
  double p2[3]=double[3](0.0,0.0,-q1/h4);
  double lim[3]=double[3](a[13],a[14],a[15]);
  for(uint d=0;d<3;d++){
   double g=abs(val[d])/lim[d]-1.0,lambda=a[LM()+(r*3+d)*7+j],z=max(0.0,lambda+a[0]*g);
   cost+=(z*z-lambda*lambda)/(2.0*a[0]);violation=max(violation,g);
   double f=z*sign(val[d])/lim[d];g0+=f*p0[d];g1+=f*p1[d];g2+=f*p2[d];
  }
 }
 uint o=AUX()+(c*p.m+r)*5;a[o]=cost;a[o+1]=g0;a[o+2]=g1;a[o+3]=g2;a[o+4]=violation;
}
