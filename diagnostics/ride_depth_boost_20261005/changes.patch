+def boosted_swing_target(app, detected_degrees):
+    """Add depth once, only after a successful search; retain the same anchor.
+
+    The session corridor already intersects the validated geometry and J7
+    bounds. Reuse its normal goal validation, never expand it for the boost.
+    """
+    degrees = float(detected_degrees) + SWING_DEPTH_BOOST_DEG
+    amount = math.radians(degrees)
+    app.hybrid_session.controller.validate_depth(amount)
+    target = app.strike_plan.anchor_joints.copy()
+    target[6] -= amount
+    return degrees, target
+
