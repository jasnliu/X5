+
+    def stop(self):
+        if self.after_id is not None:
+            self.app.root.after_cancel(self.after_id)
+            self.after_id = None
+        if self.engine is not None:
+            self.engine.stop(time.monotonic())
+        if self.stream is not None:
+            self.stream.close()
