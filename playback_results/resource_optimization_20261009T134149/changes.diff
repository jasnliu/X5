+"""Explicit-bundle CLI for X5's single-capture, shared-encoder audio process."""
+import argparse
+
+import torch
+
+from .config import load_config
+from .shared_detector import SharedDetector
+from .listener import listen_shared
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--model', action='append', nargs=4, required=True,
+                        metavar=('INSTRUMENT', 'CONFIG', 'CHECKPOINT', 'NORMALITY'))
+    parser.add_argument('--device', default='pipewire')
+    args = parser.parse_args()
+    # One CPU compute thread; no three independent PyTorch thread pools.
+    torch.set_num_threads(1)
+    torch.set_num_interop_threads(1)
+    bundles = []
+    for instrument, path, checkpoint, normality in args.model:
+        config = load_config(path)
+        if config['runtime']['instrument'] != instrument:
+            raise ValueError('Requested instrument does not match its model config')
+        bundles.append((config, checkpoint, normality))
+    detector = SharedDetector(bundles)
+    listen_shared(detector, args.device)
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
